# Environment used by the integration/API suite (tests/integration/*.int.test.js).
# It needs a throwaway Postgres database and a local JSON-RPC node; the suite
# drops and recreates every table, so never point it at real data.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:password@localhost:5432/univerify_test
BLOCKCHAIN_NODE_URL=http://localhost:8547
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=
JWT_SECRET=integration-test-secret
JWT_EXPIRY=900
BCRYPT_WORK_FACTOR=4
RATE_LIMIT_MAX=100000
RATE_LIMIT_WINDOW=3600000
CORS_ORIGIN=http://localhost:3001
